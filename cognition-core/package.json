{
  "name": "cognition-core",
  "version": "0.1.0",
  "description": "Agent introspection and telemetry analysis",
  "main": "index.ts",
  "scripts": {
    "build": "npm test",
    "analyze": "tsx scripts/analyze-history.ts --days 7",
    "analyze:quick": "tsx scripts/analyze-history.ts --days 1",
    "memory:guardrails": "tsx scripts/memory-guardrails.ts --days 7 --json reports/memory-guardrails.json --markdown reports/memory-guardrails.md",
    "memory:backfill": "tsx scripts/backfill-memory-guardrails.ts --days 30 --json reports/memory-guardrails-backfill.json --markdown reports/memory-guardrails-backfill.md",
    "iterate:plan": "tsx scripts/iterate-cognition.ts --json reports/cognition-iteration-plan.json --markdown reports/cognition-iteration-plan.md --tasks-out reports/cognition-iteration-tasks.json",
    "enqueue:tasks": "tsx scripts/enqueue-task-bundles.ts",
    "dispatch:created": "tsx scripts/dispatch-created-tasks.ts",
    "review:approvals": "tsx scripts/auto-review-approvals.ts",
    "process:outbox": "tsx scripts/process-outbox.ts",
    "worker:loop": "tsx scripts/run-bot-worker-loop.ts --json reports/bot-worker-loop.json --markdown reports/bot-worker-loop.md",
    "autonomous:run": "tsx scripts/run-autonomous-openclaw.ts",
    "autopilot:loop": "tsx scripts/autopilot-loop.ts",
    "build:full": "tsx scripts/full-build.ts",
    "plan:tasks": "tsx scripts/plan-remediation-tasks.ts --report reports/cognition-report.json --out reports/remediation-tasks.json",
    "plan:skills": "tsx scripts/plan-skill-growth-tasks.ts --report reports/learning-loop.json --out reports/skill-growth-tasks.json",
    "learn:loop": "tsx scripts/learn-from-outcomes.ts --store ../swarm-protocol/state/tasks.journal.jsonl --skills-catalog ../skills/generated/runtime.catalog.json --state-in reports/learning-state.json --state-out reports/learning-state.json --json reports/learning-loop.json --markdown reports/learning-loop.md",
    "graph": "tsx scripts/graph.ts",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "introspection",
    "openclaw"
  ],
  "author": "Z <zach@zachwright.xyz>",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
