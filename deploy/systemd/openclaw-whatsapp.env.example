# Public Twilio / WhatsApp bridge settings.
WHATSAPP_BRIDGE_HOST=0.0.0.0
WHATSAPP_BRIDGE_PORT=8787
WHATSAPP_BRIDGE_BASE_URL=https://your-public-tunnel.example

# Twilio WhatsApp credentials.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Strongly recommended: only allow your own WhatsApp number(s).
WHATSAPP_ALLOWED_SENDERS=whatsapp:+15551234567
TWILIO_VERIFY_SIGNATURES=true

# Codex bridge behavior.
CODEX_WORKDIR=/Users/zacharywright/Documents/GitHub/OpenClaw-Code
CODEX_MODEL=gpt-5-codex
CODEX_TIMEOUT_MS=180000
CODEX_DANGEROUS=false

# Optional tuning.
WHATSAPP_HISTORY_MESSAGES=8
WHATSAPP_REPLY_CHARS=1400
